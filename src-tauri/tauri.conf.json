{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Shift",
  "version": "0.5.3",
  "identifier": "app.workbuddyshift.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy Shift · WorkBuddy 账号切换",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421 http://localhost:1420 http://127.0.0.1:1420 ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/companion-runtime"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1Q0E1NTU3REZEMDFBQUEKUldTcUd0RGZWMVhLbGMzYklIT3pXaU9rTzJuVXBieXZpWWFRZlpaUVhnUVJEeFZodGRZajVBQ2YK",
      "endpoints": [
        "https://github.com/magicapple123/workbuddy-shift/releases/latest/download/latest.json",
        "https://github.com/magicapple123/workbuddy-shift/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ]
    }
  }
}
